# Copiar a .env.docker (ignorado). Archivo privado solo para el backend Docker.
APP_NAME=SIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=debug
BCRYPT_ROUNDS=12
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
AD_HOST=
AD_PORT=389
AD_USE_TLS=false
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_EMPLOYEE_ATTR=postOfficeBox
ALFRESCO_BASE_URL=
ALFRESCO_USER=
ALFRESCO_PASS=
ALFRESCO_SITE=
# Configurar en privado la contraseña inicial indicada en el requerimiento.
# No se utiliza para cambiar una contraseña existente.
BOOTSTRAP_ADMIN_PASSWORD=
# Caché de preflight, aplicada únicamente en este entorno.
CORS_MAX_AGE=600
